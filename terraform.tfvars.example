access_key = ""
secret_key = ""
region     = "us-east-1"

dbuser     = "odoodbuser"
dbpassword = "odoodbpassword"
db_engine_version = "15.3"
odoo_version = "17.0"

ssh_key      = "<ssh key name>"
ssh_key_path = "/home/ubuntu/.ssh/key.pem"

ec2_instance_type = "t4g.medium"
rds_instance_type = "db.t4g.medium"

